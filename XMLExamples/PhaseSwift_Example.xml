<?xml version="1.0" encoding="utf-8"?>
<PhaseSwiftConfig>
    <!-- 程序窗口中显示的名称 -->
    <!-- English: Name displayed in the program window -->
    <ProgramName>相位穿梭</ProgramName>
    <!-- 背景颜色：支持颜色名 (Red)、十六进制 (#4488FF)、或CustomColor预设名 -->
    <!-- English: Background color: supports color names (Red), hex (#4488FF), or CustomColor preset names -->
    <BackgroundColor>LDTchara</BackgroundColor>
    <!-- 音乐交叉渐变的默认时长（秒） -->
    <!-- English: Default music crossfade duration (seconds) -->
    <DefaultFadeDuration>1.5</DefaultFadeDuration>
    <!-- 主题切换时的闪烁时长（秒），建议与 DefaultFadeDuration 相同 -->
    <!-- English: Theme flicker duration (seconds), recommended to match DefaultFadeDuration -->
    <ThemeFlickerDuration>0.8</ThemeFlickerDuration>
    <!-- 启动后默认激活的场景索引（从 0 开始） -->
    <!-- English: Default active scene index on startup (0-based) -->
    <InitialScene>0</InitialScene>
    <!--
         PS 完成/退出后的「节点可见性」处理模式（FinishMode）
         三种模式：
           none   — 完全清理：隐藏所有受控节点，恢复主题。默认。
           full   — 全整合：保留所有场景已发现的节点可见，恢复主题。
           scene_0~N — 仅保留指定场景的节点可见（如 scene_2 保留场景 2），恢复主题。

         结束后的拓扑（链接）由下面的 TopologyMode 单独控制，两者相互独立。
    -->
    <!-- English:
         FinishMode — How node VISIBILITY is handled when PS completes/exits.
         Three modes:
           none   — Full cleanup: hide all managed nodes, restore theme. Default.
           full   — Full integration: keep all discovered nodes visible, restore theme.
           scene_0~N — Keep only the specified scene's nodes visible (e.g. scene_2), restore theme.

         The topology (links) left behind is controlled separately by TopologyMode below; the two are independent.
    -->
    <FinishMode>none</FinishMode>

    <!--
         PS 完成/退出后的「拓扑」处理模式（TopologyMode）
         三种模式：
           restore  — 恢复 PS 启动时备份的原始链接。默认。
           scene_0~N — 先恢复原始链接，再叠加场景 N 的 <Topology>（等同于运行期停在该场景的状态）。
           merge    — 清除受控节点之间的链接后，把所有场景的 <Topology> 合并叠加（按 from→to 单向去重）。

         注意：merge 会连通「后续场景」的路径，玩家可能提前抵达尚未经历的场景，
               建议只在剧情线已全部走完、要交还自由探索时使用。
         注意：scene_N 的 N 超出场景数量时回退 restore 并输出 Warn。
    -->
    <!-- English:
         TopologyMode — How the TOPOLOGY (links) is handled when PS completes/exits.
         Three modes:
           restore  — Restore the original links snapshotted at PS startup. Default.
           scene_0~N — Restore original links, then overlay scene N's <Topology> (same as staying on that scene at runtime).
           merge    — Clear links between managed nodes, then merge every scene's <Topology> (deduplicated per from-to pair).

         NOTE: merge connects paths from LATER scenes, letting players reach scenes not yet experienced.
               Use it only after the story line is fully finished and free exploration is restored.
         NOTE: An out-of-range N in scene_N falls back to restore and logs a Warn.
    -->
    <TopologyMode>restore</TopologyMode>

    <!-- ============================================================
         文本局部化
         以下字段控制 PS 中各个框架元素的显示文字。
         全部可选，不填则回退到内置词典（未来将支持 Locales/*.xml 外部语言文件）。
         ============================================================ -->
    <!-- English:
         Text Localization
         The following fields control the display text of various UI elements in PS.
         All optional; if left empty, falls back to built-in dictionary (future support for Locales/*.xml external language files).
    -->
    <!--
         准备阶段（NotStarted）的"开始"按钮文字
    -->
    <!-- English: "Start" button text during NotStarted phase -->
    <StartButtonText>激活</StartButtonText>
    <!--
         运行阶段（Active）的"Shift"按钮文字
    -->
    <!-- English: "Shift" button text during Active phase -->
    <ShiftButtonText>穿梭</ShiftButtonText>
	<!--
         PS 完成时显示的文字（不填回退到内置词典）
    -->
	<!-- English: Text displayed when PS completes (falls back to built-in dictionary if empty) -->
	<CompleteText>完成</CompleteText>
    <!--
         是否显示当前场景数 (X/X)
    -->
    <!-- English: Whether to show current scene number (X/X) -->
    <ShowSceneNumber>true</ShowSceneNumber>
    <!-- 切换主题时是否同时改变节点布局（默认 false，只变色不改位置） -->
    <!-- English: Whether changing the theme also changes node layout (default false, color-only) -->
    <ChangeLayout>false</ChangeLayout>
    <!--
         多轨音乐开关（默认 true；DSEI 每场景一轨同时播放）
         true  — DSEI 流式解码 + 交叉淡化 + 自制可视化（需要 MusicPhases）
         false — 用 MusicManager 播放单曲，不使用 DSEI 和交叉淡化。
                 此时 MusicPhases 留空，用 <SingleTrack> 指定音乐即可。
         旧字段 <UseDualTrackMusic> 仍兼容，但新配置请用 <UseMultiTrackMusic>。
    -->
    <!-- English:
         Multi-track music toggle (default true; one DSEI track per scene)
         true  — DSEI streaming decode + crossfade + custom visualization (requires MusicPhases)
         false — Use MusicManager for single-track playback without DSEI or crossfade.
                 Leave MusicPhases empty and use <SingleTrack> to specify the music.
         Legacy <UseDualTrackMusic> is still accepted; use <UseMultiTrackMusic> in new configs.
    -->
    <UseMultiTrackMusic>true</UseMultiTrackMusic>
    <!--
         单曲模式音乐（UseMultiTrackMusic=false 时有效）
         指定内容名或相对路径。不填则回退到 MusicPhases 第一个 Track。
         例: Music/MySong 或 ../Extensions/扩展名/Music/MySong.ogg
    -->
    <!-- English:
         Single-track music (effective when UseMultiTrackMusic=false)
         Specify a content name or relative path. Falls back to the first Track in MusicPhases if empty.
         Example: Music/MySong or ../Extensions/ExtensionName/Music/MySong.ogg
    -->
    <SingleTrack></SingleTrack>
    <!--
         PS 停止时是否自动恢复启动前的主题（默认 true）
         false 时作者可通过 Action 自行控制完成时的主题。
    -->
    <!-- English:
         Whether to automatically restore the pre-start theme when PS stops (default true)
         When false, extension authors can control the completion theme via Actions.
    -->
    <RestoreThemeOnStop>true</RestoreThemeOnStop>
    <!-- 跨场景发现同步（默认 true）：节点在场景 A 被发现后，切到场景 B 时若 B 的 VisibleNodes 也包含此节点，保持可见 -->
    <!-- English: Cross-scene discovery sync (default true): nodes discovered in scene A remain visible when switching to scene B if B's VisibleNodes also contain them -->
    <GlobalDiscovery>true</GlobalDiscovery>
    <!-- ============================================================
         音乐组 (MusicPhases)
         每个 Phase 定义一组音乐文件，数量应与场景数一致。
         索引 i 的 Track 对应 Scenes 中索引 i 的场景。
         不同 Phase 可在游戏过程中通过 PhaseSwitchMusicPhase Action 切换。
         强烈建议扩展作者使同 Phase 内所有音乐长度完全一致，
         否则切换时进度会逐渐错位。
         ============================================================ -->
    <!-- English:
         Music Phases
         Each Phase defines a set of music files; the count should match the number of scenes.
         Track at index i corresponds to the scene at index i in Scenes.
         Different Phases can be switched during gameplay via the PhaseSwitchMusicPhase Action.
         It is strongly recommended that all tracks within the same Phase have identical lengths,
         otherwise playback progress will drift on switch.
    -->
    <MusicPhases>
        <Phase id="0">
            <!-- <Track> 的属性全是可选的，不写 = 整曲循环、原速、原音量。
                 All <Track> attributes are optional; omitted = loop the whole file, normal speed, normal volume.

                 · LoopStart / LoopEnd：循环区间，单位**秒**。
                     先从头播到 LoopEnd，之后只在 [LoopStart, LoopEnd] 里循环
                     （即开头那段会完整播一次）。
                     只写 LoopEnd → 从 0 播到该处后回 0；都不写 → 整曲循环。
                     写反（LoopEnd <= LoopStart）→ 记一条警告并回退整曲循环，音乐照常。
                   Loop region in seconds; plays from the start through LoopEnd, then loops
                   inside [LoopStart, LoopEnd]. Inverted values fall back to whole-file looping
                   with a warning; playback is never interrupted.

                 · Pitch：范围 -1 ~ 1，0 = 原速。底层 AL_PITCH = 2^pitch，所以 0.5 ≈ 1.41 倍速。
                     ⚠️ 变速必然变调（音频底层机制，不是缺陷）；超出范围会被夹到 ±1。
                   Pitch in -1..1, 0 = normal. Backed by AL_PITCH = 2^pitch, so 0.5 ~ 1.41x.
                   Changing speed always changes pitch; out-of-range values are clamped.

                 · Volume：单曲音量倍率，1 = 不变、0.5 = 减半、0 = 静音，
                     与场景音量、玩家音量相乘，交叉淡化期间也生效。
                   Per-track volume multiplier: 1 = unchanged, 0.5 = half, 0 = silent.
                   Multiplied with the scene and player volumes; stays active during crossfades.

                 ⚠️ 同一 Phase 内各轨长度必须一致 —— 音乐按下标与场景绑定，切换场景是
                    淡入淡出而非重新计时，长度不同会让进度逐次错位。
                   Tracks within one Phase must be the same length: music is bound to scenes by
                   index and crossfades rather than restarting, so differing lengths drift. -->
            <Tracks>
                <Track>Music/Rock1.ogg</Track>
                <Track>Music/EDM1.ogg</Track>
            </Tracks>
        </Phase>
        <Phase id="1">
            <!-- 用上四个属性的例子：第 1 轨只循环 12~45 秒这段、稍微放慢并压低音量；
                 第 2 轨仍走整曲循环，便于对比。
                 An example using all four: track 1 loops only 12-45s, a little slower and quieter;
                 track 2 keeps whole-file looping for comparison. -->
            <Tracks>
                <Track LoopStart="12" LoopEnd="45" Pitch="-0.2" Volume="0.8">Music/Rock2.ogg</Track>
                <Track>Music/EDM2.ogg</Track>
            </Tracks>
        </Phase>
    </MusicPhases>
    <!-- ============================================================
         场景定义 (Scenes)
         每个 Scene 描述一个"表/里世界"的配置。
         数量不限（2~4 个均可），点击 Shift 按钮会按序号循环切换。

         受控节点：所有在 StartNodes、VisibleNodes、Topology 和
         BlockedNodes 中出现的节点都会由 PhaseSwift 全权管理。
         非受控节点不受影响。
         ============================================================ -->
    <!-- English:
         Scene Definitions (Scenes)
         Each Scene describes the configuration of a "surface/underworld" layer.
         Unlimited count (2~4 are fine); clicking the Shift button cycles through them.

         Managed nodes: All nodes appearing in StartNodes, VisibleNodes, Topology, and
         BlockedNodes are fully managed by PhaseSwift.
         Unmanaged nodes are unaffected.
    -->
    <Scenes>
        <!-- ======== 场景 0：表层世界 ======== -->
        <!-- English: ======== Scene 0: Surface World ======== -->
        <Scene id="0">
            <!--
                 场景主题。
                 若不填则保持 PS 启动前（或上一个 Scene 的 OnSwitch Action 设置的）的主题不变。
                 如需自定义，可填内置主题名 (HacknetBlue/HacknetMint/HacknetOrange/HacknetRed)、
                 自定义主题文件路径。
            -->
            <!-- English:
                 Scene theme.
                 If left empty, keeps the theme from before PS started (or set by the previous Scene's OnSwitch Action).
                 Customize with built-in theme names (HacknetBlue/HacknetMint/HacknetOrange/HacknetRed)
                 or a custom theme file path.
            -->
            <Theme>HacknetBlue</Theme>
            <!-- 切换到此场景时执行的动作文件（可选） -->
            <!-- English: Action file to execute when switching to this scene (optional) -->
            <OnSwitch file="Actions/scene0_switch.xml" />
            <!--
                 起始节点：切换到此场景时默认可见的节点。
                 只有这些节点会直接出现在网络地图中，
                 其余节点需要通过扫描拓扑链路自然发现。
            -->
            <!-- English:
                 Start nodes: Nodes visible by default when switching to this scene.
                 Only these nodes appear directly on the network map;
                 other nodes must be discovered by scanning topology links.
            -->
            <StartNodes>
                <Node id="A" />
            </StartNodes>
            <!--
                 场景所有节点：本场景用到的完整节点列表。
                 用于连接拦截和受控管理，不影响初始可见性。
            -->
            <!-- English:
                 All scene nodes: Complete node list used by this scene.
                 Used for connection blocking and managed node tracking; does not affect initial visibility.
            -->
            <VisibleNodes>
                <Node id="A" />
                <Node id="C" />
                <Node id="D" />
                <Node id="E" />
            </VisibleNodes>
            <!--
                 网络拓扑：描述本场景中受控节点之间的连接关系。
                 PS 会先清除受控节点间的所有现有链接（无论 XML 中是否有 <dlink>），再按此配置添加链接。
				 这意味着即使某个节点原本是孤立的，只要出现在拓扑中就会被强制连线。
                 切换场景时会重新应用新场景的拓扑。
            -->
            <!-- English:
                 Network topology: Describes connections between managed nodes in this scene.
                 PS first clears all existing links between managed nodes (regardless of existing <dlink> elements),
                 then adds links per this config.
                 This means even isolated nodes will be forcefully connected if they appear in the topology.
                 Switching scenes reapplies the new scene's topology.
            -->
            <Topology>
                <Link from="A" to="C" />
                <Link from="C" to="D" />
                <Link from="D" to="E" />
            </Topology>
            <!--
                 黑名单：阻止玩家 direct connect 到这些节点。
            -->
            <!-- English: Blacklist: prevents players from direct connecting to these nodes -->
            <BlockedNodes>
                <Node>B</Node>
                <Node>F</Node>
            </BlockedNodes>
        </Scene>
        <!-- ======== 场景 1：里层世界 ======== -->
        <!-- English: ======== Scene 1: Underworld ======== -->
        <Scene id="1">
            <Theme>HacknetMint</Theme>
            <OnSwitch file="Actions/scene1_switch.xml" />
            <StartNodes>
                <Node id="A" />
            </StartNodes>
            <VisibleNodes>
                <Node id="A" />
                <Node id="B" />
                <Node id="D" />
                <Node id="F" />
            </VisibleNodes>
            <Topology>
                <Link from="A" to="B" />
                <Link from="B" to="D" />
                <Link from="D" to="F" />
            </Topology>
            <BlockedNodes>
                <Node>C</Node>
                <Node>E</Node>
            </BlockedNodes>
        </Scene>
    </Scenes>
</PhaseSwiftConfig>
