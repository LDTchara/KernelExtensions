<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>11</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CS8500;MSB3277</NoWarn>
    <AnalysisMode>Recommended</AnalysisMode>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PlatformTarget>x86</PlatformTarget>
    <AssemblyTitle>KernelExtensions</AssemblyTitle>
    <Description>A mod that adds some useful things for Hacknet via Pathfinder API.</Description>
    <Company>LDTchara</Company>
    <Product>KernelExtensions</Product>
    <Copyright>Copyright © 2026 LDTchara</Copyright>
    <Version>0.7.0</Version>
    <FileVersion>0.7.0</FileVersion>
    <AssemblyVersion>0.7.0</AssemblyVersion>
  </PropertyGroup>
    
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>libs\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Core">
      <HintPath>libs\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Hacknet">
      <HintPath>libs\BepInEx.Hacknet.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FNA">
      <HintPath>libs\FNA.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Hacknet">
      <HintPath>libs\HacknetPathfinder.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mono.Cecil">
      <HintPath>libs\Mono.Cecil.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MonoMod.RuntimeDetour">
      <HintPath>libs\MonoMod.RuntimeDetour.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MonoMod.Utils">
      <HintPath>libs\MonoMod.Utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PathfinderAPI">
      <HintPath>libs\PathfinderAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ImGui.NET">
      <!-- 使用 libs 下的 ImGui.NET（1.90.0.1，与 cimgui.dll 原生层版本配套），
           由 Costura 织入嵌入程序集，运行时不再依赖外部 ImGui.NET.dll。 -->
      <HintPath>libs\ImGui.NET.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyCImGui" AfterTargets="Build">
    <!-- 拷贝 cimgui.dll（ImGui.NET 原生层，x86）到输出目录；缺失会抛 DllNotFoundException -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\libs\cimgui.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="Costura.Fody" Version="5.7.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Locales\KE-Locales.xml" />
  </ItemGroup>

  <ItemGroup>
    <!-- 标题横幅图标（dev1 合入）：raw 内嵌，运行时 GetManifestResourceStream 提取到扩展 Images/ -->
    <EmbeddedResource Include="Img\Info.png" />
    <EmbeddedResource Include="Img\InfoBG.png" />
  </ItemGroup>


</Project>
